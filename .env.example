# ─────────────────────────────────────────────────────────────────────────────
# JOB-ME SINGLE ROOT ENVIRONMENT TEMPLATE (.env or .env.local in project root)
# ─────────────────────────────────────────────────────────────────────────────
# Simply copy this file to .env or .env.local in the root directory.
# Both the frontend web dashboard and the background scraper pipeline
# automatically inherit and map all keys from this single file.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Supabase Database & Storage ─────────────────────────────────────────────
# Obtain these from your Supabase Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Note: Standard Supabase Dashboard keys (SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY,
# and SUPABASE_SECRET_KEY) are also automatically detected and aliased!

# ─── Applicant Information (Used by Playwright for ATS form filling) ─────────
APPLICANT_FIRST_NAME=Jane
APPLICANT_LAST_NAME=Doe
APPLICANT_EMAIL=jane.doe@example.com
APPLICANT_PHONE=+233201234567

# ─── Optional Features ───────────────────────────────────────────────────────
# Google Gemini API Key for AI cover letters & spam filtering (free tier: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-api-key

# Headless Playwright mode (false = see browser live during local runs, true = background)
PLAYWRIGHT_HEADLESS=false

# Optional: GitHub PAT & Repo for the "Run now" trigger button on /sources page
VITE_GITHUB_PAT=github_pat_11AAAAAA...
VITE_GITHUB_REPO=your-github-username/job-me
VITE_GITHUB_BRANCH=main
