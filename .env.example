# ─────────────────────────────────────────────────────────────────────────────
# JOB-ME MONOREPO ENVIRONMENT VARIABLES TEMPLATE
# ─────────────────────────────────────────────────────────────────────────────
# For full setup instructions, see README.md
# ─────────────────────────────────────────────────────────────────────────────

# ─── Web Application (apps/web/.env) ─────────────────────────────────────────
# Obtain these from your Supabase Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Required for the "Run now" button on /sources — GitHub PAT
# with repo + workflow scope (or fine-grained with
# Actions: Read and write)
VITE_GITHUB_PAT=github_pat_11AAAAAA...
VITE_GITHUB_REPO=your-github-username/job-me
# Optional: branch to dispatch workflow_dispatch against (default: main)
VITE_GITHUB_BRANCH=main


# ─── Scraper & Automation Pipeline (packages/scraper/.env & GitHub Secrets) ───
# Used by the CLI pipeline runner locally or configured in GitHub Actions Secrets
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Applicant Information for Playwright ATS Auto-Apply Connectors
APPLICANT_FIRST_NAME=Jane
APPLICANT_LAST_NAME=Doe
APPLICANT_EMAIL=jane.doe@example.com
APPLICANT_PHONE=+447123456789

# Path to CV PDF file — FALLBACK only. Auto-apply prefers the file of each
# job's role-matched cv_versions row (downloaded from Supabase Storage).
# (In GitHub Actions, seeded automatically as /tmp/resume.pdf when a CV exists.)
CV_FILE_PATH=/tmp/resume.pdf
