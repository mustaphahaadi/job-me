# ─────────────────────────────────────────────────────────────────────────────
# JOB-ME SINGLE ROOT ENVIRONMENT TEMPLATE (.env or .env.local in project root)
# ─────────────────────────────────────────────────────────────────────────────
# Simply copy this file to .env or .env.local in the root directory.
# Both the frontend web dashboard and the background scraper pipeline
# automatically inherit and map all keys from this single file.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Supabase Database & Storage ─────────────────────────────────────────────
# Obtain these from your Supabase Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-key-here
SUPABASE_SECRET_KEY=your-service-role-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Applicant Information (Used by Playwright for ATS form filling) ─────────
APPLICANT_FIRST_NAME=Jane
APPLICANT_LAST_NAME=Doe
APPLICANT_EMAIL=jane.doe@example.com
APPLICANT_PHONE=+233201234567

# ─── AI — OpenRouter (cover letters & spam filtering) ────────────────────────
# Get your key at https://openrouter.ai/keys  (free tier available)
# Default model: google/gemini-2.5-flash
OPENROUTER_API_KEY=your-openrouter-api-key
# OPENROUTER_MODEL=openai/gpt-4o-mini  # optional — uncomment to override model

# ─── Playwright ───────────────────────────────────────────────────────────────
# false = see browser live during local runs | true = headless/background
PLAYWRIGHT_HEADLESS=false

# ─── Optional: "Run now" trigger on the /sources page ───────────────────────
# The GitHub PAT is NOT a frontend variable. It lives only in Supabase Edge
# Function secrets so it is never bundled into the public web app:
#   supabase functions deploy trigger-pipeline --no-verify-jwt
#   supabase secrets set GH_TOKEN=github_pat_... GITHUB_REPO=owner/repo GITHUB_BRANCH=main
