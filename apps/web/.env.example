# Web app (apps/web)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# The "Run now" button on /sources calls the trigger-pipeline Supabase Edge
# Function. The GitHub PAT must NOT be a VITE_* variable: Vite inlines those
# into the public browser bundle. Store it as Edge Function secrets instead:
#   supabase functions deploy trigger-pipeline --no-verify-jwt
#   supabase secrets set GH_TOKEN=... GITHUB_REPO=owner/repo GITHUB_BRANCH=main
