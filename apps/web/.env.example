# Web app (apps/web)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Required for the "Run now" button on /sources
# GitHub PAT with repo + workflow scope (or fine-grained with
# Actions: Read and write). Keep it in the deployment env, not in git.
VITE_GITHUB_PAT=your-github-pat-with-repo-scope
VITE_GITHUB_REPO=owner/repo-name
# Optional: branch to dispatch workflow_dispatch against (default: main)
VITE_GITHUB_BRANCH=main
