# Web app (apps/web)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: enables "Run now" on /sources via GitHub API
VITE_GITHUB_PAT=your-github-pat-with-repo-scope
VITE_GITHUB_REPO=owner/repo-name
# Optional: branch to dispatch workflow_dispatch against (default: main)
VITE_GITHUB_BRANCH=main
