# Scraper / GitHub Actions secrets (NEVER commit real values)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Applicant credentials for auto-apply connectors
APPLICANT_FIRST_NAME=
APPLICANT_LAST_NAME=
APPLICANT_EMAIL=
APPLICANT_PHONE=

# Path to CV file for Playwright upload (local dev only — in CI, set via secrets)
CV_FILE_PATH=/path/to/your-cv.pdf

# Optional: Gemini API key for AI cover letter generation and spam filtering
# Free tier: 15 req/min, 1M tokens/day — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
