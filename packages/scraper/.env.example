# Scraper / GitHub Actions secrets (NEVER commit real values)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Applicant credentials for auto-apply connectors
APPLICANT_FIRST_NAME=
APPLICANT_LAST_NAME=
APPLICANT_EMAIL=
APPLICANT_PHONE=

# Path to CV file for Playwright upload (local dev only — CI downloads the latest CV from Storage)
CV_FILE_PATH=/path/to/your-cv.pdf

# Optional: OpenRouter API key — enables AI cover letter generation and spam filtering.
# Get yours at https://openrouter.ai/keys  (free tier available)
# Default model: google/gemini-2.5-flash — override via OPENROUTER_MODEL
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
